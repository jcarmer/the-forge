{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "sandbox.config.ts"],
  // Tests of web/src helpers use the web bundler's module resolution: typechecked by tsconfig.webtests.json.
  "exclude": ["test/gitRepoDetail.test.ts", "test/gitTileChips.test.ts"]
}
