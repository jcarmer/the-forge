# GENERATED by sandboxctl from sandbox.config.ts. Do not edit by hand.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    IS_SANDBOX=1 \
    TOKEN_SAVER_ENABLED=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential unzip jq procps python3 python3-pip ripgrep \
    libfontconfig1 libxcursor1 libxinerama1 libxrandr2 libxi6 libasound2 libpulse0 libgl1 libvulkan1 \
    zlib1g zstd gnupg debian-keyring debian-archive-keyring apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# .NET SDK
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="${DOTNET_ROOT}:${PATH}"
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 10.0 --install-dir ${DOTNET_ROOT} \
    && rm /tmp/dotnet-install.sh && ln -sf ${DOTNET_ROOT}/dotnet /usr/bin/dotnet

# Node.js + pnpm (via corepack)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/* \
    && corepack enable

# Godot .NET (headless only; used by TBE)
ENV GODOT_VERSION=4.8-dev7
RUN mkdir -p /opt/godot && \
    wget -q https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_mono_linux_x86_64.zip -O /tmp/godot.zip && \
    unzip /tmp/godot.zip -d /opt/godot && rm /tmp/godot.zip && \
    ln -s /opt/godot/Godot_v${GODOT_VERSION}_mono_linux_x86_64/Godot_v${GODOT_VERSION}_mono_linux.x86_64 /usr/local/bin/godot

# Caddy (preview reverse proxy)
RUN curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key | gpg --dearmor -o /usr/share/keyrings/caddy.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/caddy.gpg] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main" > /etc/apt/sources.list.d/caddy.list \
    && apt-get update && apt-get install -y caddy && rm -rf /var/lib/apt/lists/*

# VS Code CLI (provides `code tunnel`)
RUN curl -fsSL "https://code.visualstudio.com/sha/download?build=stable&os=cli-alpine-x64" -o /tmp/vscode-cli.tar.gz \
    && tar -xzf /tmp/vscode-cli.tar.gz -C /usr/local/bin && rm /tmp/vscode-cli.tar.gz

# Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Antigravity CLI
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash || true

# Claude Code (+ root-safe wrapper)
RUN npm install -g @anthropic-ai/claude-code && \
    printf '#!/bin/bash\nexport IS_SANDBOX=1\nexec /usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe "$@"\n' > /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude && ln -sf /usr/local/bin/claude /usr/bin/claude && \
    echo 'export IS_SANDBOX=1' > /etc/profile.d/sandbox.sh

# T3 Code
RUN (curl -fsSL https://t3.codes/install.sh | bash || npm install -g t3@latest) && \
    (ln -sf /root/.local/bin/t3 /usr/local/bin/t3 || true)

# Local-model agent harness
RUN npm install -g opencode-ai || true

ENV PATH="/root/.local/bin:${PATH}"

# uv + Python (ComfyUI and Python projects)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && /root/.local/bin/uv python install 3.12

RUN git config --global --add safe.directory "*" && \
    git config --global worktree.useRelativePaths true && \
    git config --global user.name "AI Sandbox Agent" && \
    git config --global user.email "agent@sandbox.local"

WORKDIR /projects
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
