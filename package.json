{
  "name": "sandboxctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds and operates the AI agent sandbox (Docker + Tailscale + T3 + Ollama) from a typed manifest.",
  "bin": {
    "sandboxctl": "dist/cli.js"
  },
  "scripts": {
    "sandboxctl": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webtests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "croner": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
